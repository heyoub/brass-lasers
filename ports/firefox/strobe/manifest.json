{
  "manifest_version": 2,
  "name": "Brass Lasers Strobe",
  "version": "1.0.0",
  "description": "High contrast. Pure black, UV magenta, electric cyan, laser yellow. Every syntax color at WCAG AAA (7:1).",
  "author": "heyoub",
  "homepage_url": "https://github.com/heyoub/brass-lasers",
  "browser_specific_settings": { "gecko": { "id": "brass-lasers-strobe@heyoub" } },
  "theme": {
    "colors": {
      "frame": "#030304",
      "frame_inactive": "#020202",
      "tab_background_text": "#7f7f89",
      "tab_selected": "#050507",
      "tab_text": "#ffffff",
      "tab_line": "#ff5fdc",
      "tab_loading": "#ffe24d",
      "toolbar": "#050507",
      "toolbar_text": "#ffffff",
      "toolbar_top_separator": "#13131a",
      "toolbar_bottom_separator": "#13131a",
      "toolbar_field": "#09090d",
      "toolbar_field_text": "#ffffff",
      "toolbar_field_border": "#1d1d24",
      "toolbar_field_focus": "#101015",
      "toolbar_field_border_focus": "#ff5fdc",
      "toolbar_field_highlight": "#9c4c87",
      "toolbar_field_highlight_text": "#fcfcfc",
      "icons": "#c3c4cf",
      "icons_attention": "#ffe24d",
      "popup": "#101015",
      "popup_text": "#ffffff",
      "popup_border": "#1d1d24",
      "popup_highlight": "#59324e",
      "popup_highlight_text": "#fcfcfc",
      "sidebar": "#030304",
      "sidebar_text": "#eeeade",
      "sidebar_border": "#13131a",
      "sidebar_highlight": "#59324e",
      "sidebar_highlight_text": "#fcfcfc",
      "button_background_hover": "#111116",
      "button_background_active": "#1e1e27",
      "ntp_background": "#050507",
      "ntp_text": "#ffffff"
    }
  }
}
