{
  "manifest_version": 2,
  "name": "Brass Lasers Strobe",
  "version": "1.0.0",
  "description": "High contrast. Deeper void, brighter lasers, every syntax color at WCAG AAA (7:1).",
  "author": "heyoub",
  "homepage_url": "https://github.com/heyoub/brass-lasers",
  "browser_specific_settings": { "gecko": { "id": "brass-lasers-strobe@heyoub" } },
  "theme": {
    "colors": {
      "frame": "#030106",
      "frame_inactive": "#020104",
      "tab_background_text": "#9b8fc3",
      "tab_selected": "#040209",
      "tab_text": "#fcf7ed",
      "tab_line": "#fe7aaf",
      "tab_loading": "#ffd595",
      "toolbar": "#040209",
      "toolbar_text": "#fcf7ed",
      "toolbar_top_separator": "#0c041f",
      "toolbar_bottom_separator": "#0c041f",
      "toolbar_field": "#06030f",
      "toolbar_field_text": "#fcf7ed",
      "toolbar_field_border": "#120728",
      "toolbar_field_focus": "#090418",
      "toolbar_field_border_focus": "#fe7aaf",
      "toolbar_field_highlight": "#38015a",
      "toolbar_field_highlight_text": "#fdfdfd",
      "icons": "#d9cdfa",
      "icons_attention": "#ffd595",
      "popup": "#090418",
      "popup_text": "#fcf7ed",
      "popup_border": "#120728",
      "popup_highlight": "#1e0123",
      "popup_highlight_text": "#fdfdfd",
      "sidebar": "#030106",
      "sidebar_text": "#e8e2f5",
      "sidebar_border": "#0c041f",
      "sidebar_highlight": "#1e0123",
      "sidebar_highlight_text": "#fdfdfd",
      "button_background_hover": "#0a041c",
      "button_background_active": "#13052e",
      "ntp_background": "#040209",
      "ntp_text": "#fcf7ed"
    }
  }
}
