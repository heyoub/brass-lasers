      "toolbar_field_border": "#1d2f5c",
      "toolbar_field_focus": "#16213f",
      "toolbar_field_border_focus": "#ff9f43",
      "toolbar_field_highlight": "#3f8ad0",
      "toolbar_field_highlight_text": "#f8fafe",
