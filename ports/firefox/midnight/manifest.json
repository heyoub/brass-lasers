{
  "manifest_version": 2,
  "name": "Brass Lasers Midnight",
  "version": "1.0.0",
  "description": "Navy ink, moonlight text and sodium-orange streetlights. The walk between stages.",
  "author": "heyoub",
  "homepage_url": "https://github.com/heyoub/brass-lasers",
  "browser_specific_settings": { "gecko": { "id": "brass-lasers-midnight@heyoub" } },
  "theme": {
    "colors": {
      "frame": "#0c111d",
      "frame_inactive": "#0a0e18",
      "tab_background_text": "#747f98",
      "tab_selected": "#0e1526",
      "tab_text": "#dfe7f4",
      "tab_line": "#ff9f43",
      "tab_loading": "#f5d76e",
      "toolbar": "#0e1526",
      "toolbar_text": "#dfe7f4",
      "toolbar_top_separator": "#16244b",
