      "popup_highlight": "#385a7d",
      "popup_highlight_text": "#f8fafe",
      "sidebar": "#0c111d",
      "sidebar_text": "#c5d7f4",
      "sidebar_border": "#16244b",
      "sidebar_highlight": "#385a7d",
      "sidebar_highlight_text": "#f8fafe",
      "button_background_hover": "#142245",
      "button_background_active": "#1d3060",
      "ntp_background": "#0e1526",
      "ntp_text": "#dfe7f4"
    }
