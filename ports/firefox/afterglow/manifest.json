{
  "manifest_version": 2,
  "name": "Brass Lasers Afterglow",
  "version": "1.0.0",
  "description": "The comedown set. Same lot, lasers dimmed, softer saturation for long sessions.",
  "author": "heyoub",
  "homepage_url": "https://github.com/heyoub/brass-lasers",
  "browser_specific_settings": { "gecko": { "id": "brass-lasers-afterglow@heyoub" } },
  "theme": {
    "colors": {
      "frame": "#0f0d15",
      "frame_inactive": "#0c0a10",
