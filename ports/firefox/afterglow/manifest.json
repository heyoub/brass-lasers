{
  "manifest_version": 2,
  "name": "Brass Lasers Afterglow",
  "version": "1.0.0",
  "description": "The sky right after the sun drops. Wine-plum dusk, coral clouds, mint grass, blue-hour light.",
  "author": "heyoub",
  "homepage_url": "https://github.com/heyoub/brass-lasers",
  "browser_specific_settings": { "gecko": { "id": "brass-lasers-afterglow@heyoub" } },
  "theme": {
    "colors": {
      "frame": "#171114",
      "frame_inactive": "#130e10",
      "tab_background_text": "#907983",
      "tab_selected": "#1d1418",
      "tab_text": "#f4e4d6",
      "tab_line": "#ff7a6b",
      "tab_loading": "#f29bb2",
      "toolbar": "#1d1418",
      "toolbar_text": "#f4e4d6",
      "toolbar_top_separator": "#35222b",
      "toolbar_bottom_separator": "#35222b",
      "toolbar_field": "#251a1f",
      "toolbar_field_text": "#f4e4d6",
      "toolbar_field_border": "#432b36",
      "toolbar_field_focus": "#2f1f26",
      "toolbar_field_border_focus": "#ff7a6b",
      "toolbar_field_highlight": "#ca6559",
      "toolbar_field_highlight_text": "#fffaf6",
      "icons": "#cab0bb",
      "icons_attention": "#f29bb2",
      "popup": "#2f1f26",
      "popup_text": "#f4e4d6",
      "popup_border": "#432b36",
      "popup_highlight": "#7c4a43",
      "popup_highlight_text": "#fffaf6",
      "sidebar": "#171114",
      "sidebar_text": "#e7d2bf",
      "sidebar_border": "#35222b",
      "sidebar_highlight": "#7c4a43",
      "sidebar_highlight_text": "#fffaf6",
      "button_background_hover": "#321f28",
      "button_background_active": "#472b38",
      "ntp_background": "#1d1418",
      "ntp_text": "#f4e4d6"
    }
  }
}
