{
  "manifest_version": 2,
  "name": "Brass Lasers Soundcheck",
  "version": "1.0.0",
  "description": "A matte finish. House lights at half, gaffer-tape charcoal, every color with the shine sanded off. Nothing glossy, nothing loud, everything in its place.",
  "author": "heyoub",
  "homepage_url": "https://github.com/heyoub/brass-lasers",
  "browser_specific_settings": { "gecko": { "id": "brass-lasers-soundcheck@heyoub" } },
  "theme": {
    "colors": {
      "frame": "#111113",
      "frame_inactive": "#0a0a0b",
      "tab_background_text": "#7f7f89",
      "tab_selected": "#18181b",
      "tab_text": "#e4e4e7",
      "tab_line": "#e580b3",
      "tab_loading": "#f0c25f",
      "toolbar": "#18181b",
      "toolbar_text": "#e4e4e7",
      "toolbar_top_separator": "#292930",
      "toolbar_bottom_separator": "#292930",
      "toolbar_field": "#1e1e22",
      "toolbar_field_text": "#e4e4e7",
      "toolbar_field_border": "#34343c",
      "toolbar_field_focus": "#25252a",
      "toolbar_field_border_focus": "#e580b3",
      "toolbar_field_highlight": "#4297a7",
      "toolbar_field_highlight_text": "#f8f8fa",
      "icons": "#b5b5c0",
      "icons_attention": "#f0c25f",
      "popup": "#25252a",
      "popup_text": "#e4e4e7",
      "popup_border": "#34343c",
      "popup_highlight": "#32636c",
      "popup_highlight_text": "#f8f8fa",
      "sidebar": "#111113",
      "sidebar_text": "#d3d2de",
      "sidebar_border": "#292930",
      "sidebar_highlight": "#32636c",
      "sidebar_highlight_text": "#f8f8fa",
      "button_background_hover": "#26262d",
      "button_background_active": "#35353e",
      "ntp_background": "#18181b",
      "ntp_text": "#e4e4e7"
    }
  }
}
