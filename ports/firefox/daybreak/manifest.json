{
  "manifest_version": 2,
  "name": "Brass Lasers Daybreak",
  "version": "1.0.0",
  "description": "First light over the lot. Porcelain mist, indigo ink, dawn-rose keywords, dew-green strings.",
  "author": "heyoub",
  "homepage_url": "https://github.com/heyoub/brass-lasers",
  "browser_specific_settings": { "gecko": { "id": "brass-lasers-daybreak@heyoub" } },
  "theme": {
    "colors": {
      "frame": "#f0f1f4",
      "frame_inactive": "#ebecef",
      "tab_background_text": "#666d83",
      "tab_selected": "#f5f6fb",
      "tab_text": "#262a4a",
      "tab_line": "#be3278",
      "tab_loading": "#8a5a00",
      "toolbar": "#f5f6fb",
      "toolbar_text": "#262a4a",
      "toolbar_top_separator": "#dee0ea",
      "toolbar_bottom_separator": "#dee0ea",
      "toolbar_field": "#edeef4",
      "toolbar_field_text": "#262a4a",
      "toolbar_field_border": "#d1d3de",
      "toolbar_field_focus": "#e3e5ed",
      "toolbar_field_border_focus": "#be3278",
      "toolbar_field_highlight": "#99a9fb",
      "toolbar_field_highlight_text": "#1a1d2f",
      "icons": "#484d74",
      "icons_attention": "#8a5a00",
      "popup": "#e3e5ed",
      "popup_text": "#262a4a",
      "popup_border": "#d1d3de",
      "popup_highlight": "#c9d3fe",
      "popup_highlight_text": "#1a1d2f",
      "sidebar": "#f0f1f4",
      "sidebar_text": "#31365c",
      "sidebar_border": "#dee0ea",
      "sidebar_highlight": "#c9d3fe",
      "sidebar_highlight_text": "#1a1d2f",
      "button_background_hover": "#e1e3ed",
      "button_background_active": "#cfd1df",
      "ntp_background": "#f5f6fb",
      "ntp_text": "#262a4a"
    }
  }
}
