      "popup_highlight": "#544a75",
      "popup_highlight_text": "#fcfcfc",
      "sidebar": "#0a0a0b",
      "sidebar_text": "#e0e0eb",
      "sidebar_border": "#222226",
      "sidebar_highlight": "#544a75",
      "sidebar_highlight_text": "#fcfcfc",
      "button_background_hover": "#1f1f23",
      "button_background_active": "#2d2d34",
      "ntp_background": "#111113",
      "ntp_text": "#f4f4f5"
    }
