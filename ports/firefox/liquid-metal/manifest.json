{
  "manifest_version": 2,
  "name": "Brass Lasers Liquid Metal",
  "version": "1.0.0",
  "description": "Molten chrome under the headliner. Graphite and mercury, with the yellow-cyan-purple spark spectrum of an oil slick.",
  "author": "heyoub",
  "homepage_url": "https://github.com/heyoub/brass-lasers",
  "browser_specific_settings": { "gecko": { "id": "brass-lasers-liquid-metal@heyoub" } },
  "theme": {
    "colors": {
      "frame": "#0a0a0b",
