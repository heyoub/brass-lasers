{
  "name": "Brass Lasers Atrium 5AM",
  "author": "heyoub",
  "variables": {
    "base": "#151c1b", "fg": "#e6dfca", "line": "#1b2625", "selection": "#04a19a",
    "comment": "#7e8f88", "doc": "#909e94", "sub0": "#8ba29f", "brass": "#e7ad70",
    "brassLight": "#d18e99", "peach": "#e9c79c", "pink": "#79c9c3", "pinkLight": "#dba9b3",
    "orchid": "#8fb7b1", "cyan": "#c4a2d8", "cyanLight": "#a6e2dc", "sunset": "#e3977a",
    "uv": "#9db8d6", "lavender": "#bcd6d0", "red": "#e07b7b", "lime": "#a6c6a0", "afterglow": "#a6c6a0"
  },
  "globals": {
    "background": "var(base)",
    "foreground": "var(fg)",
    "caret": "var(pink)",
    "line_highlight": "var(line)",
    "selection": "var(selection)",
    "selection_border": "var(selection)",
    "gutter_foreground": "#485f5c",
    "gutter_foreground_highlight": "var(brass)",
    "find_highlight": "var(brass)",
    "find_highlight_foreground": "#1a0b00",
    "brackets_foreground": "var(pink)",
    "bracket_contents_foreground": "var(pink)",
    "tags_foreground": "var(pink)",
    "invisibles": "#2e423f",
    "guide": "#233432",
    "active_guide": "#43716b",
    "accent": "var(pink)"
  },
  "rules": [
    { "name": "Comment", "scope": "comment, punctuation.definition.comment", "foreground": "var(comment)", "font_style": "italic" },
    { "name": "Doc comment", "scope": "comment.block.documentation", "foreground": "var(doc)", "font_style": "italic" },
    { "name": "Keyword", "scope": "keyword, storage, storage.type, storage.modifier", "foreground": "var(pink)" },
    { "name": "Control flow", "scope": "keyword.control.flow, keyword.control.return, keyword.control.loop, keyword.control.conditional", "foreground": "var(pink)", "font_style": "italic" },
    { "name": "Operator", "scope": "keyword.operator, punctuation.accessor", "foreground": "var(orchid)" },
    { "name": "String", "scope": "string, punctuation.definition.string", "foreground": "var(afterglow)" },
    { "name": "Escape / regex", "scope": "constant.character.escape, string.regexp, punctuation.section.embedded", "foreground": "var(cyan)" },
    { "name": "Number / constant", "scope": "constant.numeric, constant.language, constant.other, variable.other.constant", "foreground": "var(sunset)" },
    { "name": "Function", "scope": "entity.name.function, support.function, variable.function", "foreground": "var(cyan)" },
    { "name": "Macro", "scope": "entity.name.function.macro, support.macro", "foreground": "var(cyanLight)", "font_style": "bold" },
    { "name": "Type", "scope": "entity.name.type, entity.name.class, entity.name.struct, entity.name.enum, support.type, support.class, storage.type.primitive", "foreground": "var(brass)" },
    { "name": "Type parameter", "scope": "entity.name.type.parameter", "foreground": "var(peach)", "font_style": "italic" },
    { "name": "Namespace", "scope": "entity.name.namespace, entity.name.module", "foreground": "var(uv)" },
    { "name": "Variable", "scope": "variable, variable.other", "foreground": "var(fg)" },
    { "name": "Parameter", "scope": "variable.parameter", "foreground": "var(brassLight)", "font_style": "italic" },
    { "name": "Property", "scope": "variable.other.member, variable.other.property, meta.object-literal.key, support.type.property-name", "foreground": "var(lavender)" },
    { "name": "self / this", "scope": "variable.language", "foreground": "var(pinkLight)", "font_style": "italic" },
    { "name": "Attribute / decorator", "scope": "meta.attribute, meta.decorator, entity.name.function.decorator", "foreground": "var(uv)", "font_style": "italic" },
    { "name": "Punctuation", "scope": "punctuation", "foreground": "var(sub0)" },
    { "name": "Tag", "scope": "entity.name.tag", "foreground": "var(pink)" },
    { "name": "Tag attribute", "scope": "entity.other.attribute-name", "foreground": "var(brassLight)", "font_style": "italic" },
    { "name": "Heading", "scope": "markup.heading, entity.name.section", "foreground": "var(brass)", "font_style": "bold" },
    { "name": "Bold", "scope": "markup.bold", "foreground": "var(sunset)", "font_style": "bold" },
    { "name": "Italic", "scope": "markup.italic", "foreground": "var(pinkLight)", "font_style": "italic" },
    { "name": "Inline code", "scope": "markup.raw", "foreground": "var(afterglow)" },
    { "name": "Link", "scope": "markup.underline.link", "foreground": "var(cyan)" },
    { "name": "Inserted", "scope": "markup.inserted", "foreground": "var(lime)" },
    { "name": "Deleted", "scope": "markup.deleted", "foreground": "var(red)" },
    { "name": "Changed", "scope": "markup.changed", "foreground": "var(brass)" },
    { "name": "Invalid", "scope": "invalid", "foreground": "var(red)", "font_style": "underline" }
  ]
}
