    "label": { "foreground": "#feaf81", "fontStyle": "" },
    "decorator": { "foreground": "#c3abff", "fontStyle": "" },
    "attributeBracket": "#c3abff",
    "keyword": "#fe7aaf",
    "operator": "#ffa3d6",
    "string": "#beff7d",
    "number": "#feaf81",
    "boolean": "#feaf81",
    "escapeSequence": "#92fff1",
    "formatSpecifier": "#92fff1",
    "comment": { "foreground": "#a398d0", "fontStyle": "" },
    "unresolvedReference": { "foreground": "#ff818e", "fontStyle": "underline" },
    "*.mutable": { "fontStyle": "underline" },
    "*.unsafe": { "foreground": "#ff818e", "fontStyle": "bold" },
    "*.deprecated": { "fontStyle": "strikethrough" }
  }
}
