    "builtinType": "#fff5c6",
    "enumMember": "#ffa24d",
    "function": "#2ee8ff",
    "method": "#2ee8ff",
    "macro": { "foreground": "#7cf7ff", "fontStyle": "bold" },
    "parameter": { "foreground": "#ffd38a", "fontStyle": "italic" },
    "variable": "#fdf8ec",
    "variable.constant": "#ffa24d",
    "variable.readonly": "#fff7d2",
    "property": "#a8f2ff",
    "selfKeyword": { "foreground": "#ff8de2", "fontStyle": "italic" },
    "selfTypeKeyword": "#ffe24d",
    "lifetime": { "foreground": "#ffa24d", "fontStyle": "italic" },
    "label": { "foreground": "#ffa24d", "fontStyle": "italic" },
    "decorator": { "foreground": "#c2a8ff", "fontStyle": "italic" },
    "attributeBracket": "#c2a8ff",
    "keyword": "#ff5fdc",
    "operator": "#ff9ad6",
    "string": "#86ff6a",
    "number": "#ffa24d",
    "boolean": "#ffa24d",
    "escapeSequence": "#2ee8ff",
    "formatSpecifier": "#2ee8ff",
    "comment": { "foreground": "#b9b4cf", "fontStyle": "italic" },
    "unresolvedReference": { "foreground": "#fe6679", "fontStyle": "underline" },
    "*.mutable": { "fontStyle": "underline" },
