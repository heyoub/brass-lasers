  "tokenColors": [
    {
      "name": "Comments: fog machine, legible on purpose",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#808089", "fontStyle": "" }
    },
    {
      "name": "Doc comments: slightly less fog",
      "scope": ["comment.block.documentation", "comment.line.documentation", "string.quoted.docstring"],
      "settings": { "foreground": "#85858d", "fontStyle": "" }
    },
    {
      "name": "Keywords: the hot pink laser",
      "scope": ["keyword", "keyword.control", "storage", "storage.type", "storage.modifier", "keyword.operator.new", "keyword.operator.expression", "keyword.other"],
      "settings": { "foreground": "#e580b3" }
    },
    {
      "name": "Control flow gets italics so returns jump out",
      "scope": ["keyword.control.flow", "keyword.control.return", "keyword.control.loop", "keyword.control.conditional", "keyword.control.trycatch"],
      "settings": { "foreground": "#e580b3", "fontStyle": "" }
    },
    {
      "name": "Operators: dimmed magenta so math is not a strobe",
      "scope": ["keyword.operator", "punctuation.accessor", "keyword.operator.assignment"],
      "settings": { "foreground": "#a1a1a8" }
    },
    {
      "name": "Strings: afterglow lime",
      "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string"],
      "settings": { "foreground": "#55bf70" }
    },
    {
      "name": "Escapes, regex, interpolation punctuation: cyan",
      "scope": ["constant.character.escape", "string.regexp", "punctuation.definition.template-expression", "punctuation.section.embedded", "constant.other.placeholder"],
      "settings": { "foreground": "#60cfe3" }
    },
    {
      "name": "Numbers and constants: sunset",
      "scope": ["constant.numeric", "constant.language", "constant.character", "constant.other", "variable.other.constant", "variable.other.enummember", "support.constant"],
      "settings": { "foreground": "#ec9a5e" }
    },
    {
      "name": "Functions: laser cyan",
      "scope": ["entity.name.function", "support.function", "meta.function-call entity.name.function", "variable.function", "entity.name.function.macro", "support.macro"],
      "settings": { "foreground": "#60cfe3" }
    },
    {
      "name": "Types and classes: sax brass",
      "scope": ["entity.name.type", "entity.name.class", "entity.name.struct", "entity.name.enum", "entity.name.trait", "entity.name.interface", "support.type", "support.class", "entity.other.inherited-class", "storage.type.primitive", "keyword.type"],
      "settings": { "foreground": "#f0c25f" }
    },
    {
      "name": "Generic type parameters: peach fuzz",
      "scope": ["entity.name.type.parameter", "meta.type.parameters entity.name.type", "storage.type.generic"],
      "settings": { "foreground": "#c3b8f0", "fontStyle": "" }
    },
    {
      "name": "Namespaces and modules: ultraviolet",
      "scope": ["entity.name.namespace", "entity.name.module", "entity.name.package", "support.module", "meta.path entity.name"],
      "settings": { "foreground": "#a591e7" }
    },
    {
      "name": "Variables: stay calm, you are most of the screen",
      "scope": ["variable", "variable.other", "variable.other.readwrite", "meta.definition.variable"],
      "settings": { "foreground": "#dedeea" }
    },
    {
      "name": "Parameters: brass, lighter, italic",
      "scope": ["variable.parameter", "meta.parameter"],
      "settings": { "foreground": "#f2be89", "fontStyle": "" }
    },
    {
      "name": "Properties and fields: lavender",
      "scope": ["variable.other.property", "variable.other.member", "variable.other.object.property", "meta.object-literal.key", "support.type.property-name", "entity.name.tag.yaml", "support.type.property-name.json", "support.type.property-name.toml"],
      "settings": { "foreground": "#b5f0f7" }
    },
    {
      "name": "this / self / super",
      "scope": ["variable.language", "variable.language.this", "variable.language.self", "variable.language.super"],
      "settings": { "foreground": "#efafd1", "fontStyle": "" }
    },
    {
      "name": "Rust lifetimes and labels",
      "scope": ["entity.name.lifetime", "punctuation.definition.lifetime", "storage.modifier.lifetime", "entity.name.label"],
      "settings": { "foreground": "#ec9a5e", "fontStyle": "" }
    },
    {
      "name": "Attributes, decorators, annotations",
      "scope": ["meta.attribute", "meta.attribute.rust", "entity.name.function.decorator", "meta.decorator", "punctuation.decorator", "storage.type.annotation", "punctuation.definition.attribute"],
      "settings": { "foreground": "#a591e7", "fontStyle": "" }
    },
    {
      "name": "Punctuation: present but not screaming",
      "scope": ["punctuation", "punctuation.separator", "punctuation.terminator", "meta.brace", "punctuation.definition.block", "punctuation.definition.parameters"],
      "settings": { "foreground": "#9b9ba5" }
    },
    {
      "name": "Tags",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#e580b3" }
    },
    {
      "name": "Components (JSX/TSX)",
      "scope": ["support.class.component", "entity.name.tag.custom"],
      "settings": { "foreground": "#f0c25f" }
    },
    {
      "name": "Attribute names",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#f2be89", "fontStyle": "" }
    },
    {
      "name": "CSS selectors and properties",
      "scope": ["entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css", "entity.other.attribute-name.pseudo-class.css"],
      "settings": { "foreground": "#60cfe3" }
    },
    {
      "name": "CSS property names",
      "scope": ["support.type.property-name.css", "support.type.vendored.property-name.css"],
      "settings": { "foreground": "#b5f0f7" }
    },
    {
      "name": "Units",
      "scope": ["keyword.other.unit"],
      "settings": { "foreground": "#ec9a5e" }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading", "entity.name.section", "punctuation.definition.heading"],
      "settings": { "foreground": "#f0c25f", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#ec9a5e", "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic"],
      "settings": { "foreground": "#efafd1", "fontStyle": "" }
    },
    {
      "name": "Markdown code",
      "scope": ["markup.inline.raw", "markup.fenced_code.block", "markup.raw"],
      "settings": { "foreground": "#55bf70" }
    },
    {
      "name": "Markdown links",
      "scope": ["markup.underline.link", "string.other.link", "meta.link"],
      "settings": { "foreground": "#60cfe3" }
    },
    {
      "name": "Markdown quotes and lists",
      "scope": ["markup.quote", "punctuation.definition.list.begin.markdown"],
      "settings": { "foreground": "#a591e7" }
    },
    {
      "name": "Diff inserted",
      "scope": ["markup.inserted", "meta.diff.header.to-file", "punctuation.definition.inserted"],
      "settings": { "foreground": "#55bf70" }
    },
    {
      "name": "Diff deleted",
      "scope": ["markup.deleted", "meta.diff.header.from-file", "punctuation.definition.deleted"],
      "settings": { "foreground": "#e77f7c" }
    },
    {
      "name": "Diff changed",
      "scope": ["markup.changed", "meta.diff.range"],
      "settings": { "foreground": "#f0c25f" }
    },
    {
      "name": "Invalid: the rail-rider who lost their friends",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#e77f7c", "fontStyle": "underline" }
    },
    {
      "name": "Deprecated",
      "scope": ["invalid.deprecated"],
      "settings": { "foreground": "#9b9ba5", "fontStyle": "strikethrough" }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#a591e7",
    "type": "#f0c25f",
    "class": "#f0c25f",
    "struct": "#f0c25f",
    "enum": "#f0c25f",
