    "selfTypeKeyword": "#eab308",
    "lifetime": { "foreground": "#ff6b6b", "fontStyle": "italic" },
    "label": { "foreground": "#ff6b6b", "fontStyle": "italic" },
    "decorator": { "foreground": "#8c5ef8", "fontStyle": "italic" },
    "attributeBracket": "#8c5ef8",
    "keyword": "#a78bfa",
    "operator": "#a1a1aa",
    "string": "#f3e3b5",
    "number": "#ff6b6b",
    "boolean": "#ff6b6b",
    "escapeSequence": "#22d3ee",
