{
  "name": "brass-lasers-4am",
  "displayName": "Brass Lasers 4AM — Neon Synthwave Dark Theme",
  "description": "Neon synthwave themes for VS Code & Cursor: 4AM, Afterglow, Strobe (AAA high contrast) and Golden Hour (light), plus matching file icons. Void-purple chrome, brass-gold accents, hot-pink lasers, lime strings. Readable at 4AM.",
  "version": "0.3.0",
  "publisher": "heyoub",
  "engines": {
