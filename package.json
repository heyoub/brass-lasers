    "url": "https://github.com/heyoub/brass-lasers/issues"
  },
  "homepage": "https://github.com/heyoub/brass-lasers#readme",
  "contributes": {
    "themes": [
      {
        "label": "Brass Lasers 4AM",
        "uiTheme": "vs-dark",
        "path": "./themes/Brass-Lasers-4AM-color-theme.json"
      },
      {
        "label": "Brass Lasers 4AM No Italics",
        "uiTheme": "vs-dark",
        "path": "./themes/Brass-Lasers-4AM-No-Italics-color-theme.json"
      },
      {
        "label": "Brass Lasers Afterglow",
        "uiTheme": "vs-dark",
        "path": "./themes/Brass-Lasers-Afterglow-color-theme.json"
      },
      {
        "label": "Brass Lasers Afterglow No Italics",
        "uiTheme": "vs-dark",
        "path": "./themes/Brass-Lasers-Afterglow-No-Italics-color-theme.json"
      },
      {
        "label": "Brass Lasers Strobe",
        "uiTheme": "vs-dark",
        "path": "./themes/Brass-Lasers-Strobe-color-theme.json"
      },
      {
        "label": "Brass Lasers Strobe No Italics",
        "uiTheme": "vs-dark",
        "path": "./themes/Brass-Lasers-Strobe-No-Italics-color-theme.json"
      },
      {
        "label": "Brass Lasers Golden Hour",
        "uiTheme": "vs",
        "path": "./themes/Brass-Lasers-Golden-Hour-color-theme.json"
      },
      {
        "label": "Brass Lasers Golden Hour No Italics",
        "uiTheme": "vs",
        "path": "./themes/Brass-Lasers-Golden-Hour-No-Italics-color-theme.json"
      }
    ],
    "iconThemes": [
      {
        "id": "brass-lasers-icons",
        "label": "Brass Lasers Icons",
        "path": "./icons/brass-lasers-icon-theme.json"
      }
    ]
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "shiki": "3.13.0"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "check": "node scripts/build.js --check && node scripts/contrast.js",
    "contrast": "node scripts/contrast.js --report",
    "art": "node scripts/make-art.js",
    "package": "npx @vscode/vsce package",
    "previews": "node scripts/make-previews.js"
  }
}
