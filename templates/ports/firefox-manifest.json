{
  "manifest_version": 2,
  "name": "Brass Lasers {{meta.name}}",
  "version": "1.0.0",
  "description": "{{meta.tagline}}",
  "author": "heyoub",
  "homepage_url": "https://github.com/heyoub/brass-lasers",
