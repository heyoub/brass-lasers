<!-- Brass Lasers {{meta.name}} editor color scheme for JetBrains IDEs.
     Settings → Editor → Color Scheme → ⚙ → Import Scheme… → pick this file.
     Generated from palette/{{meta.slug}}.json. Do not edit by hand. -->
<scheme name="Brass Lasers {{meta.name}}" version="142" parent_scheme="{{meta.jetbrainsParent}}">
  <colors>
    <option name="CARET_COLOR" value="{{pink|nohash}}" />
    <option name="CARET_ROW_COLOR" value="{{lineHighlight|nohash}}" />
    <option name="CONSOLE_BACKGROUND_KEY" value="{{crust|nohash}}" />
    <option name="GUTTER_BACKGROUND" value="{{base|nohash}}" />
    <option name="INDENT_GUIDE" value="{{inactiveSelection|nohash}}" />
    <option name="SELECTED_INDENT_GUIDE" value="{{indentActive|nohash}}" />
    <option name="LINE_NUMBERS_COLOR" value="{{lineNumber|nohash}}" />
    <option name="LINE_NUMBER_ON_CARET_ROW_COLOR" value="{{brass|nohash}}" />
    <option name="METHOD_SEPARATORS_COLOR" value="{{border1|nohash}}" />
    <option name="RIGHT_MARGIN_COLOR" value="{{inactiveSelection|nohash}}" />
    <option name="SELECTION_BACKGROUND" value="{{selection|nohash}}" />
    <option name="SELECTION_FOREGROUND" value="" />
    <option name="TEARLINE_COLOR" value="{{border1|nohash}}" />
    <option name="WHITESPACES" value="{{whitespace|nohash}}" />
    <option name="ADDED_LINES_COLOR" value="{{lime|nohash}}" />
    <option name="MODIFIED_LINES_COLOR" value="{{brass|nohash}}" />
    <option name="DELETED_LINES_COLOR" value="{{red|nohash}}" />
    <option name="DOCUMENTATION_COLOR" value="{{surface1|nohash}}" />
  </colors>
  <attributes>
    <option name="TEXT"><value><option name="FOREGROUND" value="{{textEditor|nohash}}" /><option name="BACKGROUND" value="{{base|nohash}}" /></value></option>
    <option name="DEFAULT_LINE_COMMENT"><value><option name="FOREGROUND" value="{{comment|nohash}}" /><option name="FONT_TYPE" value="2" /></value></option>
    <option name="DEFAULT_BLOCK_COMMENT"><value><option name="FOREGROUND" value="{{comment|nohash}}" /><option name="FONT_TYPE" value="2" /></value></option>
    <option name="DEFAULT_DOC_COMMENT"><value><option name="FOREGROUND" value="{{docComment|nohash}}" /><option name="FONT_TYPE" value="2" /></value></option>
    <option name="DEFAULT_KEYWORD"><value><option name="FOREGROUND" value="{{pink|nohash}}" /></value></option>
    <option name="DEFAULT_STRING"><value><option name="FOREGROUND" value="{{afterglow|nohash}}" /></value></option>
    <option name="DEFAULT_VALID_STRING_ESCAPE"><value><option name="FOREGROUND" value="{{cyan|nohash}}" /></value></option>
    <option name="DEFAULT_NUMBER"><value><option name="FOREGROUND" value="{{sunset|nohash}}" /></value></option>
    <option name="DEFAULT_CONSTANT"><value><option name="FOREGROUND" value="{{sunset|nohash}}" /></value></option>
    <option name="DEFAULT_OPERATION_SIGN"><value><option name="FOREGROUND" value="{{orchid|nohash}}" /></value></option>
    <option name="DEFAULT_BRACES"><value><option name="FOREGROUND" value="{{subtext0|nohash}}" /></value></option>
    <option name="DEFAULT_BRACKETS"><value><option name="FOREGROUND" value="{{subtext0|nohash}}" /></value></option>
    <option name="DEFAULT_PARENTHS"><value><option name="FOREGROUND" value="{{subtext0|nohash}}" /></value></option>
    <option name="DEFAULT_COMMA"><value><option name="FOREGROUND" value="{{subtext0|nohash}}" /></value></option>
    <option name="DEFAULT_SEMICOLON"><value><option name="FOREGROUND" value="{{subtext0|nohash}}" /></value></option>
    <option name="DEFAULT_DOT"><value><option name="FOREGROUND" value="{{orchid|nohash}}" /></value></option>
    <option name="DEFAULT_FUNCTION_DECLARATION"><value><option name="FOREGROUND" value="{{cyan|nohash}}" /></value></option>
    <option name="DEFAULT_FUNCTION_CALL"><value><option name="FOREGROUND" value="{{cyan|nohash}}" /></value></option>
    <option name="DEFAULT_INSTANCE_METHOD"><value><option name="FOREGROUND" value="{{cyan|nohash}}" /></value></option>
    <option name="DEFAULT_STATIC_METHOD"><value><option name="FOREGROUND" value="{{cyan|nohash}}" /></value></option>
    <option name="DEFAULT_CLASS_NAME"><value><option name="FOREGROUND" value="{{brass|nohash}}" /></value></option>
    <option name="DEFAULT_INTERFACE_NAME"><value><option name="FOREGROUND" value="{{brassLight|nohash}}" /></value></option>
    <option name="DEFAULT_CLASS_REFERENCE"><value><option name="FOREGROUND" value="{{brass|nohash}}" /></value></option>
    <option name="DEFAULT_PARAMETER"><value><option name="FOREGROUND" value="{{brassLight|nohash}}" /><option name="FONT_TYPE" value="2" /></value></option>
    <option name="DEFAULT_LOCAL_VARIABLE"><value><option name="FOREGROUND" value="{{textEditor|nohash}}" /></value></option>
    <option name="DEFAULT_GLOBAL_VARIABLE"><value><option name="FOREGROUND" value="{{textEditor|nohash}}" /></value></option>
    <option name="DEFAULT_INSTANCE_FIELD"><value><option name="FOREGROUND" value="{{lavender|nohash}}" /></value></option>
    <option name="DEFAULT_STATIC_FIELD"><value><option name="FOREGROUND" value="{{lavender|nohash}}" /><option name="FONT_TYPE" value="2" /></value></option>
    <option name="DEFAULT_METADATA"><value><option name="FOREGROUND" value="{{uv|nohash}}" /><option name="FONT_TYPE" value="2" /></value></option>
    <option name="DEFAULT_LABEL"><value><option name="FOREGROUND" value="{{sunset|nohash}}" /><option name="FONT_TYPE" value="2" /></value></option>
    <option name="DEFAULT_PREDEFINED_SYMBOL"><value><option name="FOREGROUND" value="{{pinkLight|nohash}}" /><option name="FONT_TYPE" value="2" /></value></option>
    <option name="DEFAULT_TAG"><value><option name="FOREGROUND" value="{{pink|nohash}}" /></value></option>
    <option name="DEFAULT_ATTRIBUTE"><value><option name="FOREGROUND" value="{{brassLight|nohash}}" /><option name="FONT_TYPE" value="2" /></value></option>
    <option name="DEFAULT_IDENTIFIER"><value><option name="FOREGROUND" value="{{textEditor|nohash}}" /></value></option>
    <option name="DEFAULT_ENTITY"><value><option name="FOREGROUND" value="{{cyan|nohash}}" /></value></option>
    <option name="ERRORS_ATTRIBUTES"><value><option name="EFFECT_COLOR" value="{{red|nohash}}" /><option name="EFFECT_TYPE" value="2" /></value></option>
    <option name="WARNING_ATTRIBUTES"><value><option name="EFFECT_COLOR" value="{{sunset|nohash}}" /><option name="EFFECT_TYPE" value="2" /></value></option>
    <option name="INFO_ATTRIBUTES"><value><option name="EFFECT_COLOR" value="{{cyan|nohash}}" /><option name="EFFECT_TYPE" value="2" /></value></option>
    <option name="SEARCH_RESULT_ATTRIBUTES"><value><option name="BACKGROUND" value="{{accentSurface|nohash}}" /><option name="EFFECT_COLOR" value="{{brass|nohash}}" /><option name="EFFECT_TYPE" value="0" /></value></option>
    <option name="IDENTIFIER_UNDER_CARET_ATTRIBUTES"><value><option name="BACKGROUND" value="{{hover|nohash}}" /></value></option>
    <option name="WRITE_IDENTIFIER_UNDER_CARET_ATTRIBUTES"><value><option name="BACKGROUND" value="{{selectionActive|nohash}}" /></value></option>
    <option name="MATCHED_BRACE_ATTRIBUTES"><value><option name="FOREGROUND" value="{{pink|nohash}}" /><option name="FONT_TYPE" value="1" /></value></option>
    <option name="TODO_DEFAULT_ATTRIBUTES"><value><option name="FOREGROUND" value="{{brass|nohash}}" /><option name="FONT_TYPE" value="3" /></value></option>
    <option name="HYPERLINK_ATTRIBUTES"><value><option name="FOREGROUND" value="{{cyan|nohash}}" /><option name="EFFECT_COLOR" value="{{cyan|nohash}}" /><option name="EFFECT_TYPE" value="1" /></value></option>
  </attributes>
</scheme>
