    "notificationCenterHeader.background": "{{overlaySurface}}",
    "notificationLink.foreground": "{{cyan}}",
    "notificationsErrorIcon.foreground": "{{red}}",
    "notificationsWarningIcon.foreground": "{{sunset}}",
    "notificationsInfoIcon.foreground": "{{cyan}}",

    "settings.headerForeground": "{{brass}}",
    "settings.settingsHeaderHoverForeground": "{{brassLight}}",
    "settings.modifiedItemIndicator": "{{pink}}",
    "settings.headerBorder": "{{border0}}",
    "settings.sashBorder": "{{border0}}",
    "settings.focusedRowBackground": "{{hover}}",
    "settings.focusedRowBorder": "{{pink}}",
    "settings.rowHoverBackground": "{{surface0}}",
    "settings.dropdownBackground": "{{surface1}}",
    "settings.dropdownForeground": "{{text}}",
    "settings.dropdownBorder": "{{border1}}",
    "settings.dropdownListBorder": "{{border1}}",
    "settings.checkboxBackground": "{{surface1}}",
    "settings.checkboxForeground": "{{brass}}",
    "settings.checkboxBorder": "{{border2}}",
    "settings.textInputBackground": "{{surface0}}",
    "settings.textInputForeground": "{{text}}",
    "settings.textInputBorder": "{{border1}}",
    "settings.numberInputBackground": "{{surface0}}",
    "settings.numberInputForeground": "{{text}}",
    "settings.numberInputBorder": "{{border1}}",

    "chat.requestBackground": "{{surface1}}",
    "chat.requestBorder": "{{border1}}",
    "chat.slashCommandBackground": "{{pink@33}}",
    "chat.slashCommandForeground": "{{pinkLight}}",
    "chat.avatarBackground": "{{border0}}",
    "chat.avatarForeground": "{{brass}}",
    "chat.editedFileForeground": "{{brass}}",
    "chat.linesAddedForeground": "{{lime}}",
    "chat.linesRemovedForeground": "{{red}}",
    "inlineChat.background": "{{surface1}}",
    "inlineChat.foreground": "{{text}}",
    "inlineChat.border": "{{pink}}",
    "inlineChat.shadow": "{{black@80}}",
    "inlineChatInput.background": "{{surface0}}",
