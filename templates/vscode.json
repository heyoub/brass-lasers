    "terminal.ansiBrightBlack": "{{comment}}",
    "terminal.ansiBrightRed": "{{redLight}}",
    "terminal.ansiBrightGreen": "{{limeLight}}",
    "terminal.ansiBrightYellow": "{{brassLight}}",
    "terminal.ansiBrightBlue": "{{blueLight}}",
