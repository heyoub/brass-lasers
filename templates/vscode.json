    "merge.currentHeaderBackground": "{{cyan@44}}",
    "merge.currentContentBackground": "{{cyan@1a}}",
    "merge.incomingHeaderBackground": "{{pink@44}}",
    "merge.incomingContentBackground": "{{pink@1a}}",

    "terminal.background": "{{crust}}",
    "terminal.foreground": "{{lime}}",
    "terminal.selectionBackground": "{{selection@80}}",
    "terminalCursor.foreground": "{{pink}}",
